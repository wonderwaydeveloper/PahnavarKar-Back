APP_NAME=PahnavarKar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Set only after an approved Sentry project/DSN is provisioned.
SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Device sessions expire after 30 days without activity (per-token expires_at).

# Keep user withdrawal requests disabled until an outbound payout provider and secure destination flow are configured.
WALLET_WITHDRAWALS_ENABLED=false

# Zarinpal sandbox accepts any UUID string as merchant_id; no live merchant account is needed.
# Payment stays off until explicitly enabled. Production requires a separate live merchant ID.
# Production uses separate live credentials and must never be enabled as a fallback.
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_GATEWAY=zarinpal
PAYMENT_APP_RETURN_URL=pahnavarkar://payment-return
PAYMENT_GATEWAY_FAILOVER=
PAYMENT_MAX_TOP_UP=
PAYMENT_CONNECT_TIMEOUT=5
PAYMENT_TIMEOUT=15
ZARINPAL_PAYMENT_ENABLED=false
ZARINPAL_SANDBOX_MERCHANT_ID=
ZARINPAL_PRODUCTION_MERCHANT_ID=
SADAD_PAYMENT_ENABLED=false
SADAD_MERCHANT_ID=
SADAD_TERMINAL_ID=
SADAD_KEY=
SADAD_WEBHOOK_SECRET=
SADAD_CALLBACK_SECRET=
SEP_PAYMENT_ENABLED=false
SEP_MERCHANT_ID=
SEP_TERMINAL_ID=
SEP_PASSWORD=
SEP_WEBHOOK_SECRET=
SEP_CALLBACK_SECRET=

# SMS (Melipayamak shared API; keep the tokenized URL secret)
MELIPAYAMAK_ENABLED=false
MELIPAYAMAK_LOCAL_LOG_ENABLED=false
MELIPAYAMAK_API_URL=
MELIPAYAMAK_OTP_BODY_ID=
MELIPAYAMAK_INACTIVITY_WARNING_BODY_ID=
# Keep OTP delivery synchronous until the real SMS provider and a persistent queue worker are ready.
SMS_OTP_QUEUE_ENABLED=false
SMS_OTP_QUEUE=sms

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
EXPO_ACCESS_TOKEN=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Production on a single VPS behind Nginx: use Redis for shared rate-limit/cache counters.
# CACHE_STORE=redis
# Trust only the exact Nginx upstream address reaching PHP-FPM; replace if it is not loopback.
# TRUSTED_PROXIES=127.0.0.1,::1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
